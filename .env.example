NODE_ENV=development
PORT=3100
MONGODB_URI=mongodb://127.0.0.1:27018/nalara?replicaSet=rs0&directConnection=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# API docs are on for local development and should be false in production.
SWAGGER_ENABLED=true
# Firebase Admin verification. Use a service-account credential on the backend;
# never put this credential in the Flutter project.
FIREBASE_PROJECT_ID=nalara-gia
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative for local development: path to the Firebase service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=
LOG_LEVEL=info
# Password reset OTP storage and expiry.
# If REDIS_URL is filled, it takes priority over the host/port/username/password below.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional credentials for managed Redis/Redis Cloud. Keep blank for the local Compose Redis.
REDIS_USERNAME=
REDIS_PASSWORD=
PASSWORD_RESET_OTP_TTL_MINUTES=5
# Resend email delivery. RESEND_FROM_EMAIL must use a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional development recipient. When set, local OTP emails go here instead of the user's address.
RESEND_TEST_RECIPIENT=
# Optional trusted notification adapter. Must honor Idempotency-Key and the
# authorized audience in the payload; never broadcast to an entire workspace.
NOTIFICATION_DELIVERY_URL=
NOTIFICATION_DELIVERY_TOKEN=
# H-1 target/jadwal scan interval. FCM uses the same Firebase Admin credentials above.
NOTIFICATION_SCHEDULER_INTERVAL_MINUTES=15
# Durable Mongo outbox retries (no additional process/queue dependency).
NOTIFICATION_DELIVERY_INTERVAL_SECONDS=15
NOTIFICATION_DELIVERY_BATCH_SIZE=25
# Supply your own demo credentials when seeding. Never use production credentials.
SEED_EMAIL=
SEED_PHONE=
SEED_PASSWORD=

# Subscription catalog (IDR/month). Trial: Pro features, max 5 active students.
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_BASIC_PRICE=39000
SUBSCRIPTION_PRO_PRICE=79000
SUBSCRIPTION_BASIC_STUDENTS=30
# Pro has no active-student limit. Payments are off until credentials are set.
SINGAPAY_ENABLED=false
SINGAPAY_ENVIRONMENT=sandbox
SINGAPAY_CLIENT_ID=
SINGAPAY_CLIENT_SECRET=
SINGAPAY_API_KEY=
SINGAPAY_ACCOUNT_ID=
# Optional extra HMAC validation keys, comma-separated; client secret is also tried.
SINGAPAY_HMAC_KEY=
# Read-only provider reconciliation + verified atomic grant. Does not create charges.
BILLING_RECONCILIATION_INTERVAL_SECONDS=60
BILLING_RECONCILIATION_BATCH_SIZE=10
# Durable permanent account erasure, bounded jobs per pass (no admin approval).
ACCOUNT_DELETION_INTERVAL_SECONDS=60
ACCOUNT_DELETION_BATCH_SIZE=5
# Private branding logo storage. Relative paths resolve from the backend cwd.
UPLOADS_DIR=./uploads
# Register HTTPS callback: /api/v1/subscriptions/webhooks/singapay
