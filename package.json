{
  "name": "nalara-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.9 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test:subscriptions": "node --test test/subscriptions.check.cjs",
    "test:hardening": "node --test test/otp-hardening.check.cjs test/notification-audience.check.cjs test/notification-delivery.check.cjs test/notification-revocation.check.cjs test/notification-inbox.check.cjs test/notification-scheduler.check.cjs test/background-workers.check.cjs test/hardening-config.check.cjs",
    "test:teaching-guide": "node --test test/teaching-guide.check.cjs",
    "test:account-deletion": "node --test test/account-deletion.check.cjs",
    "test:branding": "node --test test/branding-logo.check.cjs",
    "test:otp:redis": "node --test test/otp-redis.integration.check.cjs",
    "verify:source": "npm run typecheck && npm run lint && npm run test:hardening && npm run test:subscriptions && npm run test:teaching-guide && npm run test:account-deletion && npm run test:branding",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node --watch dist/main.js",
    "lint": "oxlint src test",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=e2e",
    "seed": "npm run build && node dist/database/seed.js"
  },
  "dependencies": {
    "@aliziodev/singapay": "^1.1.2",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "express": "5.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "8.1.0",
    "ioredis": "^6.0.0",
    "mongoose": "9.11.2",
    "nestjs-pino": "5.3.1",
    "pdfkit": "^0.17.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pdfkit": "^0.17.3",
    "jest": "30.5.2",
    "oxlint": "1.30.0",
    "typescript": "6.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.cjs"
    ],
    "testTimeout": 30000
  }
}
